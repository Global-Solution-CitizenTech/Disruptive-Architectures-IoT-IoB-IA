# ==============================================================================
# FIAP Global Solution 2026/2 - Disruptive Architectures: IoT, IoB & Generative IA
# Configurações de Ambiente (Arquivo de Exemplo - Sem Credenciais Reais)
# ==============================================================================

# Configurações do Servidor
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Provedor de IA Generativa (gemini / mock)
# Quando GEMINI_API_KEY estiver vazia, o sistema opera automaticamente no modo
# Mock / Heurístico de Alta Fidelidade, permitindo testes sem custo ou chave de API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parâmetros de Inferência GenAI
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1024

# Configurações de IoT e IoB
IOT_ANOMALY_THRESHOLD_G=2.5
IOB_MIN_COMMUNITY_SUPPORTS_URGENT=15
IOB_MIN_COMMUNITY_SUPPORTS_CRITICAL=25

# RAG & Embeddings
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.15

