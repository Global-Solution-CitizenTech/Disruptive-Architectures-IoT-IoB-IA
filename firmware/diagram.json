{
  "version": 1,
  "author": "Equipe ZelaFix FIAP 2TDSPG",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "ultrasonic", "top": -120, "left": -80, "attrs": { "distance": "20" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": -120, "left": 140, "attrs": {} },
    { "type": "wokwi-led", "id": "led", "top": 140, "left": 60, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 140, "left": 120, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "ultrasonic:GND", "black", [ "v0" ] ],
    [ "esp:5V", "ultrasonic:VCC", "red", [ "v0" ] ],
    [ "esp:5", "ultrasonic:TRIG", "blue", [ "v0" ] ],
    [ "esp:18", "ultrasonic:ECHO", "green", [ "v0" ] ],
    [ "esp:GND.2", "ldr:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "ldr:VCC", "red", [ "v0" ] ],
    [ "esp:34", "ldr:AO", "orange", [ "v0" ] ],
    [ "esp:2", "led:A", "purple", [ "v0" ] ],
    [ "led:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {
    "bblanchon/ArduinoJson": "7.0.4"
  }
}
