# ==============================================================================
# ZelaFix AI — Exemplo de Variáveis de Ambiente (Render / Local)
# Global Solution 2 — Disruptive Architectures: IoT, IoB & Generative IA (FIAP 2TDSPG)
# ==============================================================================

# Azure AI Foundry (Endpoint compatível OpenAI v1 + chave da conta AIServices)
AI_BASE_URL=https://seu-recurso-foundry.services.ai.azure.com/openai/v1
AI_API_KEY=sua_chave_azure_ai_foundry_aqui
AI_MODEL=phi-4-multimodal
AI_EMBEDDING_MODEL=embed-v-4-0
AI_EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=25.0

# Conexão Oracle FIAP (Modo Thin Python — somente leitura)
ORACLE_USER=seu_usuario_oracle
ORACLE_PASSWORD=sua_senha_oracle
ORACLE_URL=jdbc:oracle:thin:@//oracle.fiap.com.br:1521/orcl
ORACLE_DSN=oracle.fiap.com.br:1521/orcl

# Porta de execução do servidor FastAPI (Render define automaticamente via $PORT)
PORT=8000
