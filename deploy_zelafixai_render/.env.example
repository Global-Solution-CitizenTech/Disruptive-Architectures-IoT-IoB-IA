# ==============================================================================
# ZelaFix AI — Variáveis de Ambiente e Configurações de Deploy (Render / Local)
# Global Solution 2 — Disruptive Architectures: IoT, IoB & Generative IA (FIAP 2TDSPG)
# ==============================================================================

# Chave de API da Groq Cloud (Groq Console: https://console.groq.com)
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Modelo Multimodal Groq (Visão Computacional e RAG de Zeladoria Urbana)
GROQ_MODEL=qwen/qwen3.8-27b

# Provedor de IA ativo ("groq" prioritário; fallback automático para Motor Local Resiliente)
AI_PROVIDER=groq

# ==============================================================================
# Conexão com Banco de Dados Relacional Oracle FIAP (Modo Thin nativo em Python)
# ==============================================================================
ORACLE_USER=rm566422
ORACLE_PASSWORD=sua_senha_oracle
ORACLE_URL=jdbc:oracle:thin:@//oracle.fiap.com.br:1521/orcl
ORACLE_DSN=oracle.fiap.com.br:1521/orcl

# Porta de execução do servidor FastAPI (Render define automaticamente via $PORT)
PORT=8000
