# Chave de API da Groq (Groq Console: https://console.groq.com)
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Provedor primário: "groq" (padrão) ou "gemini". O outro atua como fallback automático.
AI_PROVIDER=groq

# Chave de API do Google Gemini (Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_sua_chave_gemini_aqui

# Porta de execução do servidor FastAPI (Render define automaticamente $PORT)
PORT=8000
